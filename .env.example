# Copy to .env.local for local dev: cp .env.example .env.local
# Next.js loads .env, .env.local, .env.production, etc. — see https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
#
# Staging and production set these same names at runtime from kthaisociety/deployments,
# projects/landingpage-frontend/project.yaml: plain values there, LUMA_API_KEY from OpenBao
# (secret/landingpage-frontend/<env>), JWT_PUBLIC_KEY from the shared store (secret/shared/<env>).
# The image is the same in every environment, so nothing here may be needed at build time.

# --- Runtime config (server, and served to the browser by /runtime-env.js) ---

# Backend API origin, for the browser and the server route handlers. Read at runtime, not baked
# into the build. Default in code: http://localhost:8080
BACKEND_URL=http://localhost:8080

# --- Server-only secrets ---

# RS256 public key (PEM) for verifying the member jwt cookie in src/proxy.ts (dashboard/admin routes).
# Must be the public half of the backend's JWT signing key. Not checked under `next dev`, which skips auth.
# Multi-line PEM works in .env.local; in Docker/host env you can use literal \n in a single line (code replaces \\n with newline).
# The backend's scripts/gen-dev-secrets.sh fills this in for local dev.
JWT_PUBLIC_KEY=

# Luma calendar API key for /api/events/*
LUMA_API_KEY=

# Internal-only base URL for onboarding-service (Docker network only, no
# public DNS) — used by /api/onboarding/* to proxy the portal pages'
# submit-email/confirm actions, since the browser can't reach it directly.
ONBOARDING_SERVICE_URL=

# HS256 secret for the mock member JWT route handlers (/api/member/*) only; the real member
# cookie is the backend's RS256 jwt above. Not set in staging or production.
JWT_SECRET=

# --- Legacy ---

# Build-time backend origin, baked into the bundle. Only used when BACKEND_URL is unset, for
# builds outside the delivery pipeline. Prefer BACKEND_URL.
# NEXT_PUBLIC_API_URL=http://localhost:8080
