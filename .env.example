# Copy to .env.local for local dev: cp .env.example .env.local
# Next.js loads .env, .env.local, .env.production, etc. — see https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# --- Public (exposed to the browser; must be NEXT_PUBLIC_*) ---

# Backend API origin (browser + server route handlers). Default in code: http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google OAuth Web client ID (required for Google sign-in UI)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Server-only secrets ---

# HS256 secret for mock member JWT route handlers (/api/member/*). Must match what issues tokens in dev.
# Production should use a strong random value; keep consistent across instances that mint/verify the same cookie JWTs if applicable.
JWT_SECRET=

# RS256 public key (PEM) for verifying the member `jwt` cookie in src/proxy.ts (dashboard/admin routes).
# Multi-line PEM works in .env.local; in Docker/host env you can use literal \n in a single line (code replaces \\n with newline).
JWT_PUBLIC_KEY=

# Luma calendar API key for /api/events/*
LUMA_API_KEY=
